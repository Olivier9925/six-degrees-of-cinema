{
  "expo": {
    "name": "Six Degrees of Cinema",
    "slug": "six-degrees-of-cinema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sixdegrees",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0F",
    "ios": {
      "bundleIdentifier": "com.olivier9925.sixdegreesofcinema",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sixdegrees.cinema",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6f2c8981-7475-47ca-923e-0722219a973f"
      }
    },
    "owner": "olivier9925"
  }
}
